---
import Ticket from "@/assets/homepage/ticket-discount.svg"
import Instagram from "@/assets/homepage/instagram.svg"
import LinkedIn from "@/assets/homepage/linkedin.svg"
import TikTok from "@/assets/homepage/tiktok.svg"
import X from "@/assets/homepage/x.svg"
import YouTube from "@/assets/homepage/youtube.svg"
---

<div class="bg-primary-500 py-2">
  <div class="max-w-300 flex justify-between items-center mx-auto">
    <div class="flex gap-2 items-center">
      <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center">
        <Ticket/>
      </div>
      <p>Get 10% Discount use code “TRY NOW”</p>
      <div class="bg-white rounded-full px-3 py-1">
        <p class="text-sm text-primary-500">TRYNOW10</p>
      </div>
    </div>
    <ul class="flex gap-2 items-center">
      <li><a href="#" aria-label="Instagram"><Instagram/></a></li>
      <li><a href="#" aria-label="LinkedIn"><LinkedIn/></a></li>
      <li><a href="#" aria-label="X"><X/></a></li>
      <li><a href="#" aria-label="TikTok"><TikTok/></a></li>
      <li><a href="#" aria-label="YouTube"><YouTube/></a></li>
    </ul>
  </div>
</div>
